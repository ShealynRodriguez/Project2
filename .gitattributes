# Normalize line endings so Windows and Mac teammates don't fight over them
* text=auto

# Text files Unity and we edit by hand
*.cs     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.asmdef text eol=lf
*.unity  text eol=lf
*.prefab text eol=lf
*.asset  text eol=lf
*.meta   text eol=lf

# Binary files: never try to merge or diff as text
*.png      binary
*.jpg      binary
*.gif      binary
*.psd      binary
*.aseprite binary
*.wav      binary
*.mp3      binary
*.ogg      binary
*.ttf      binary
*.fbx      binary

# Optional: if the team ends up with large audio or art files, move the binary
# types above to Git LFS ("filter=lfs diff=lfs merge=lfs -text"). Not needed yet.
